# ========================================
# AI 服务配置说明
# ========================================
# 
# ⭐ 推荐方式：使用后端的 MiniMax AI 服务（已配置）
# 
# 后端已经配置好了 MiniMax AI 服务，前端可以直接调用：
# - 对话接口：POST /api/ai/chat
# - 生成回复：POST /api/ai/generate-reply
# - 服务状态：GET /api/ai/status
# 
# 使用示例：
# import { AIAPI } from '@/api/AIAPI'
# const response = await AIAPI.chat('你好，AI助手')
# 
# ========================================
# 备用方案：前端直接调用 AI 服务
# ========================================
# 
# 如果需要前端直接调用 AI 服务，可以配置以下选项：

# Hugging Face API Configuration
# 获取API密钥的方法：
# 1. 访问 https://huggingface.co/
# 2. 注册/登录账户
# 3. 访问 https://huggingface.co/settings/tokens
# 4. 创建新的 Access Token
# 5. 复制token并替换下面的YOUR_API_KEY_HERE

# VITE_HUGGINGFACE_API_KEY=YOUR_API_KEY_HERE

# OpenRouter API Configuration
# 获取API密钥的方法：
# 1. 访问 https://openrouter.ai/
# 2. 注册/登录账户
# 3. 访问 https://openrouter.ai/keys
# 4. 创建新的 API Key
# 5. 复制密钥并替换下面的YOUR_OPENROUTER_API_KEY_HERE
# 通义深度研究模型支持免费使用

# VITE_OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
# VITE_OPENROUTER_MODEL=alibaba/tongyi-deepresearch-30b-a3b:free

# 可选：配置其他AI服务的API密钥
# VITE_OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
