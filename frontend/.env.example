# Gemini API Configuration 示例文件
# 复制此文件为 .env.local 并填入真实的API密钥

# Hugging Face API Configuration
# 如果你有 Hugging Face API 密钥，请在这里设置
# 如果没有，系统会使用内置的模拟回复
VITE_HUGGINGFACE_API_KEY=your_huggingface_key_here

# Gemini API Configuration (推荐使用)
# ⚠️ 请填入您自己的Gemini API密钥
# 使用Gemini 2.5 Flash模型 - 免费版
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
VITE_GEMINI_MODEL=gemini-2.5-flash

# 可选：配置其他AI服务的API密钥
# VITE_OPENAI_API_KEY=your_openai_key_here
